;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="728.0" y="1600" width="144" height="22" as="geometry"/></mxCell><mxCell id="n44" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1780" as="sourcePoint"/><mxPoint x="800" y="1847" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n45" style="edgeStyle=none;html=1;rounded=0;strokeColor=#15803D;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="2005" as="sourcePoint"/><mxPoint x="800" y="2082" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n46" value="YES — verified" style="text;html=1;align=center;fontColor=#15803D;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="836.0" y="2032" width="100" height="22" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Skill Step Records (210)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;step = instruction&lt;br&gt;+ target image&lt;br&gt;+ expected-result image&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="330" width="380" height="150" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Shared Multimodal Embedder (220)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;MobileCLIP2 / SigLIP-2 (ONNX);&lt;br&gt;one text + image vector space.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="380" height="150" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Step-Granular Index (230)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Room DB + USearch HNSW&lt;br&gt;+ FTS4 lexical; indexed&lt;br&gt;per step, not per skill.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="750" width="380" height="150" as="geometry"/></mxCell><mxCell id="n50" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="480" as="sourcePoint"/><mxPoint x="1340" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n51" value="embed steps" style="text;html=1;align=center;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1295.0" y="500" width="90" height="22" as="geometry"/></mxCell><mxCell id="n52" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="690" as="sourcePoint"/><mxPoint x="1340" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n53" value="vectors + text" style="text;html=1;align=center;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1290.0" y="710" width="100" height="22" as="geometry"/></mxCell><mxCell id="n54" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;