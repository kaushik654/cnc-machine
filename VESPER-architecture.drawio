        <mxCell id="n3" value="" style="rounded=0;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="420" height="2110" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="450" height="2110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&#x27;font-size:26px&#x27;&gt;VESPER (100) — System Architecture&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="310" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="n6" value="On-Device Multimodal Skill Agent with Execution-Grounded Retrieval and Per-Step Visual Verification" style="text;html=1;align=center;fontColor=#64748B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="82" width="1200" height="30" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;REPAIR &amp; SAFETY LANE (500)&lt;/b&gt;" style="text;html=1;align=left;fontColor=#64748B;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="168" width="380" height="26" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;RUNTIME PIPELINE (300 / 400)&lt;/b&gt;" style="text;html=1;align=left;fontColor=#64748B;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="168" width="380" height="26" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;OFFLINE KNOWLEDGE LANE (200)&lt;/b&gt;" style="text;html=1;align=left;fontColor=#64748B;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="1150" y="168" width="380" height="26" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;VOICE&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="555" y="225" width="150" height="54" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;TEXT&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="725" y="225" width="150" height="54" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;SCREENSHOT&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="895" y="225" width="150" height="54" as="geometry"/></mxCell><mxCell id="n13" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="279" as="sourcePoint"/><mxPoint x="630" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n14" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="279" as="sourcePoint"/><mxPoint x="800" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n15" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="279" as="sourcePoint"/><mxPoint x="970" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Multimodal Input Fuser (310)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;ASR-transcribed voice + typed text + live-screen screenshot&lt;br&gt;fused into one query vector in the shared embedding space;&lt;br&gt;the screen state disambiguates vague requests.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="560" height="150" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Hybrid Retriever &amp; Step Router (320)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Dense (USearch HNSW) + lexical (BM25), RRF fusion (k = 60),&lt;br&gt;section boost, confidence threshold. Returns candidate steps,&lt;br&gt;conditioned on the live screen.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="540" width="560" height="150" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Planner / Orchestration Agent (330)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Composes verifiable step primitives toward the goal,&lt;br&gt;possibly across skills; emits the next step N.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="750" width="560" height="150" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Action Synthesizer (410)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Grounds step N + current screen into a concrete&lt;br&gt;executable action (structured JSON or generated code).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="960" width="560" height="140" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Backend Router (420)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Dispatches each synthesized action to its executor.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="1160" width="560" height="110" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;IN-APP (422)&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="1320" width="170" height="70" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;MCP (424)&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="1320" width="170" height="70" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;A2A (426)&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=1.5;fontColor=#334E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="1320" width="170" height="70" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Live Device Screen (430)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Post-execution UI captured as the new screen-state&lt;br&gt;image — the ground truth for verification.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="1450" width="560" height="130" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Per-Step Visual Verifier (510)&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&#x27;#0F766E&#x27;&gt;&lt;b&gt;[NOVEL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Embeds the new live screen; computes embedding similarity&lt;br&gt;against step N&#x27;s authored expected-result image.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="1640" width="560" height="140" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;sim &gt;= tau ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=2;fontSize=13;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="660" y="1855" width="280" height="150" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;&lt;font style=&#x27;font-size:15px&#x27; color=&#x27;#1F2937&#x27;&gt;Task Complete &amp; Outcome Store (530)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#475569&#x27;&gt;Report success; persist the verified outcome&lt;br&gt;to improve future ranking.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;align=left;verticalAlign=top;spacing=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="520" y="2090" width="560" height="120" as="geometry"/></mxCell><mxCell id="n28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="480" as="sourcePoint"/><mxPoint x="800" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="fused query" style="text;html=1;align=center;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="755.0" y="500" width="90" height="22" as="geometry"/></mxCell><mxCell id="n30" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="690" as="sourcePoint"/><mxPoint x="800" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n31" value="candidate steps" style="text;html=1;align=center;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="746.0" y="710" width="108" height="22" as="geometry"/></mxCell><mxCell id="n32" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="900" as="sourcePoint"/><mxPoint x="800" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n33" value="step N" style="text;html=1;align=center;fontColor=#1f2937;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="755.0" y="920" width="90" height="22" as="geometry"/></mxCell><mxCell id="n34" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1100" as="sourcePoint"/><mxPoint x="800" y="1152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n35" value="action (JSON / code)" style="text;html=1;align=center;fontColor=#64748B;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="728.0" y="1120" width="144" height="22" as="geometry"/></mxCell><mxCell id="n36" style="edgeStyle=none;html=1;rounded=0;strokeColor=#334E68;strokeWidth=2;endArrow=block;endF