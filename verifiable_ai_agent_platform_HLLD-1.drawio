<mxfile host="app.diagrams.net" type="device"><diagram name="HLLD-FIG1" id="hlld1"><mxGraphModel dx="2000" dy="1200" grid="0" guides="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1180" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FIG. 1 — High-Level Design: Verifiable AI-Agent Compliance &amp; Accountability Platform (100)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F3A5F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1720" height="24" as="geometry"/></mxCell><mxCell id="flow" value="End-to-end flow:  1 Intake → 2 Contract → 3 Enforce → 4 Govern → 5 Execute → 6 Prove → 7 Verify → 8 Certify      •      Optional: Cross-Device Handoff" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#41506A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="1720" height="20" as="geometry"/></mxCell><mxCell id="bnd" value="INTEGRATED PLATFORM (100)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F3A5F;strokeWidth=2;dashed=1;verticalAlign=top;align=right;fontStyle=2;fontSize=12;fontColor=#1F3A5F;spacingTop=6;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1640" height="770" as="geometry"/></mxCell><mxCell id="d102" value="ON-DEVICE TRUSTED EXECUTION DOMAIN (102)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F8FB;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#B7C2CE;strokeWidth=1.4;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#1F3A5F;dashed=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="600" height="700" as="geometry"/></mxCell><mxCell id="d102_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="626" y="170" width="28" height="28" as="geometry"/></mxCell><mxCell id="d104" value="REMOTE AGENT EXECUTION DOMAIN (104)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F8FB;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#B7C2CE;strokeWidth=1.4;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#1F3A5F;dashed=0;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="600" height="700" as="geometry"/></mxCell><mxCell id="d104_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1636" y="170" width="28" height="28" as="geometry"/></mxCell><mxCell id="band" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3FAF3;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#9FBF9F;strokeWidth=1.4;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fontColor=#1A1A1A;dashed=1;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="910" width="1610" height="200" as="geometry"/></mxCell><mxCell id="m110" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Task Intake &amp; Intent Layer (110)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Galaxy AI Assistant: receives user task; performs intent analysis &amp; risk classification.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F1FA;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7BFDC;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="100" y="228" width="540" height="112" as="geometry"/></mxCell><mxCell id="m110_cir" style="ellipse;html=1;fillColor=#D4E5F4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="265.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m110_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="120" y="271.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m120" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Execution Contract Authority — TEE (120)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Generates a hardware-signed, task-specific execution contract (an allowed-action state machine) and binds it to the request via nonce + integrity seal.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=56;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="100" y="362" width="540" height="150" as="geometry"/></mxCell><mxCell id="m120_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="418.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m120_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="120" y="424.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m120_tag" value="NOVEL" style="rounded=1;arcSize=40;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="576" y="370" width="52" height="18" as="geometry"/></mxCell><mxCell id="m170" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Independent Verification Module — TEE (170)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Re-derives the state machine, recomputes &amp; matches proofs, validates action compliance, and flags overreach &amp; policy violations.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FBF4DA;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#D9C684;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=56;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="540" height="150" as="geometry"/></mxCell><mxCell id="m170_cir" style="ellipse;html=1;fillColor=#F0E3BB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="616.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m170_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="120" y="622.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m170_tag" value="NOVEL" style="rounded=1;arcSize=40;html=1;fillColor=#C08A1E;strokeColor=#C08A1E;fontColor=#FFFFFF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="576" y="568" width="52" height="18" as="geometry"/></mxCell><mxCell id="m180" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Compliance Certificate &amp; Secure Store (180)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Issues a device-signed compliance certificate (task, status, overreach summary); stored securely on device.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F1FA;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7BFDC;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="100" y="738" width="540" height="104" as="geometry"/></mxCell><mxCell id="m180_cir" style="ellipse;html=1;fillColor=#D4E5F4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="114" y="771.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m180_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="120" y="777.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m140" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Remote Compliance Enforcement Engine (140)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Verifies the signed contract, reconstructs the policy state machine, and enforces permitted state transitions &amp; action permissions at runtime.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=56;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1110" y="228" width="540" height="152" as="geometry"/></mxCell><mxCell id="m140_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1124" y="285.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m140_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1130" y="291.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m140_tag" value="NOVEL" style="rounded=1;arcSize=40;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1586" y="236" width="52" height="18" as="geometry"/></mxCell><mxCell id="m150" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Runtime Governance Subsystem (150)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;User approval for sensitive actions (approve / reject / timeout); continuous signed heartbeat attestation with auto-suspend on failure.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=56;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1110" y="400" width="540" height="140" as="geometry"/></mxCell><mxCell id="m150_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1124" y="451.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m150_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1130" y="457.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m150_tag" value="NOVEL" style="rounded=1;arcSize=40;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1586" y="408" width="52" height="18" as="geometry"/></mxCell><mxCell id="m160" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;AI Agent Execution Engine (160)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Executes governed agent operations: tool use, data access, reasoning, and content generation.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F1FA;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7BFDC;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1110" y="560" width="540" height="108" as="geometry"/></mxCell><mxCell id="m160_cir" style="ellipse;html=1;fillColor=#D4E5F4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1124" y="595.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m160_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1130" y="601.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m190" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Dual-Accountability Proof Engine (190)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Generates data-access &amp; data-usage proofs; detects overreach (accessed-but-not-used); emits minimal-footprint signed attestations (Merkle).&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=56;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1110" y="688" width="540" height="152" as="geometry"/></mxCell><mxCell id="m190_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1124" y="745.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="m190_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1130" y="751.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="m190_tag" value="NOVEL" style="rounded=1;arcSize=40;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1586" y="696" width="52" height="18" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Secure Channel (TLS) (106)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Mutually authenticated, encrypted transport.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EAF0F8;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#9DB4D2;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="788" y="452" width="184" height="104" as="geometry"/></mxCell><mxCell id="sec_cir" style="ellipse;html=1;fillColor=#D8E3F2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="802" y="485.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="sec_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="808" y="491.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="t200" value="CROSS-DEVICE HANDOFF SUBSYSTEM — Optional (200)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6A3FB5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="760" y="916" width="400" height="24" as="geometry"/></mxCell><mxCell id="h202" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Secure State Transfer (202)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Encrypt &amp; transfer the state bundle via mutual authentication (Knox Matrix).&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="120" y="978" width="470" height="104" as="geometry"/></mxCell><mxCell id="h202_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="134" y="1011.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="h202_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="140" y="1017.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="h204" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Dual Hardware Attestation (204)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Source + destination TEEs co-sign the handoff using their hardware keys.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="640" y="978" width="470" height="104" as="geometry"/></mxCell><mxCell id="h204_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="654" y="1011.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="h204_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="660" y="1017.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="h206" value="&lt;b&gt;&lt;font color="#1F3A5F"&gt;Continuous Proof Chain (206)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#5A5A5A"&gt;Destination resumes execution; heartbeat &amp; proofs remain cryptographically continuous.&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.3;verticalAlign=middle;align=left;fontSize=11;fontColor=#5A5A5A;shadow=1;spacingLeft=58;spacingRight=12;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1160" y="978" width="470" height="104" as="geometry"/></mxCell><mxCell id="h206_cir" style="ellipse;html=1;fillColor=#D4EAD4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1174" y="1011.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="h206_ic" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/png;base64,; " vertex="1" parent="1"><mxGeometry x="1180" y="1017.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="l200" value="(Novel)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#2E7D32;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1088" width="1610" height="18" as="geometry"/></mxCell><mxCell id="lg" value="LEGEND" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F3A5F;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1142" width="80" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E9F5E9;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#A7C7A7;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="180" y="1144" width="30" height="18" as="geometry"/></mxCell><mxCell id="lg1t" value="Novel / Claimed Components" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1A1A1A;wh