        <mxCell id="h_b" value="&lt;b&gt;Dual Hardware Attestation&lt;/b&gt;&lt;br&gt;Source &amp; destination TEEs co-sign the handoff using their respective hardware keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
