<mxfile host="app.diagrams.net" type="device">
  <diagram name="FIG-1-System-Architecture" id="patent-fig1">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="FIG. 1 — VERIFIABLE AI-AGENT COMPLIANCE &amp; ACCOUNTABILITY PLATFORM" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1560" height="36" as="geometry" />
        </mxCell>

        <!-- System boundary (100) -->
        <mxCell id="boundary" value="INTEGRATED PLATFORM (100)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F3A5F;strokeWidth=2;dashed=1;verticalAlign=top;align=right;fontStyle=2;fontSize=12;spacingTop=6;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1560" height="1020" as="geometry" />
        </mxCell>

        <!-- On-device domain (102) -->
        <mxCell id="dom_device" value="ON-DEVICE TRUSTED EXECUTION ENVIRONMENT (TEE) — 102" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#8A8A8A;strokeWidth=1.5;dashed=0;verticalAlign=top;align=center;fontStyle=1;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="480" height="650" as="geometry" />
        </mxCell>

        <!-- Remote domain (104) -->
        <mxCell id="dom_remote" value="REMOTE AGENT EXECUTION ENVIRONMENT — 104" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#8A8A8A;strokeWidth=1.5;dashed=0;verticalAlign=top;align=center;fontStyle=1;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="820" height="650" as="geometry" />
        </mxCell>

        <!-- 110 Task intake -->
        <mxCell id="m110" value="&lt;b&gt;(110) User Task Intake — Galaxy AI Assistant&lt;/b&gt;&lt;br&gt;Receives user task request and identity; forwards to on-device contract authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- 120 Contract authority (NOVEL) -->
        <mxCell id="m120" value="&lt;b&gt;(120) Execution Contract Authority — TEE&amp;nbsp;&amp;nbsp;★ NOVEL&lt;/b&gt;&lt;br&gt;• Intent analysis &amp; risk classification&lt;br&gt;• Generates task-specific execution contract encoding an allowed-action state machine&lt;br&gt;• Seals contract with hardware (TEE) signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="295" width="420" height="120" as="geometry" />
        </mxCell>

        <!-- 130 Contract binding (NOVEL) -->
        <mxCell id="m130" value="&lt;b&gt;(130) Contract Binding &amp; Packaging Module&amp;nbsp;&amp;nbsp;★ NOVEL&lt;/b&gt;&lt;br&gt;• Generates per-request nonce&lt;br&gt;• Cryptographically binds signed contract to request (integrity)&lt;br&gt;• Emits sealed, signed request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="420" height="100" as="geometry" />
        </mxCell>

        <!-- 180 Independent verification (NOVEL) -->
        <mxCell id="m180" value="&lt;b&gt;(180) Independent Verification Module — TEE&amp;nbsp;&amp;nbsp;★ NOVEL&lt;/b&gt;&lt;br&gt;On-device, independent re-verification:&lt;br&gt;• Re-derive state machine &amp; recompute / match proofs&lt;br&gt;• Validate action compliance&lt;br&gt;• Identify overreach &amp; policy violations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="595" width="420" height="120" as="geometry" />
        </mxCell>

        <!-- 190 Compliance certificate -->
        <mxCell id="m190" value="&lt;b&gt;(190) Compliance Certificate &amp; Secure Store&lt;/b&gt;&lt;br&gt;Device-signed certificate (task summary, compliance status, overreach summary); stored securely on device." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="730" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- 106 Secure channel (outbound) -->
        <mxCell id="sec106" value="&lt;b&gt;🔒 (106)&lt;br&gt;Secure Channel (TLS)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#1F4E79;strokeWidth=1.5;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="585" y="455" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- 165 Execution proof trace (return artifact) -->
        <mxCell id="trace165" value="&lt;b&gt;(165) Execution Proof Trace&lt;/b&gt;&lt;br&gt;• Merkle roots / leaves&lt;br&gt;• Overreach summary&lt;br&gt;• Attestations &amp; signatures&lt;br&gt;• Selective disclosure (opt.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#B58A00;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="582" y="600" width="156" height="120" as="geometry" />
        </mxCell>

        <!-- 140 Remote compliance enforcement (NOVEL) -->
        <mxCell id="m140" value="&lt;b&gt;(140) Remote Compliance Enforcement Engine&amp;nbsp;&amp;nbsp;★ NOVEL&lt;/b&gt;&lt;br&gt;• Verifies contract signature &amp; validity&lt;br&gt;• Reconstructs policy / state machine&lt;br&gt;• Enforces permitted state transitions &amp; action permissions at runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="205" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- 150 Runtime governance -->
        <mxCell id="m150" value="&lt;b&gt;(150) Runtime Governance Subsystem&lt;/b&gt;&lt;br&gt;• User Approval: pre-action commitment &amp; approve / reject / timeout for sensitive actions&lt;br&gt;• Heartbeat Attestation: continuous signed device attestation; auto-suspend on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="450" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- 160 AI agent execution engine -->
        <mxCell id="m160" value="&lt;b&gt;(160) AI Agent Execution Engine&lt;/b&gt;&lt;br&gt;Executes governed agent operations under enforced permissions:&lt;br&gt;• Tool use &amp; data access&lt;br&gt;• Reasoning &amp; content generation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="205" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- 170 Dual accountability proof engine (NOVEL) -->
        <mxCell id="m170" value="&lt;b&gt;(170) Dual-Accountability Proof Engine&amp;nbsp;&amp;nbsp;★ NOVEL&lt;/b&gt;&lt;br&gt;• Data-access proofs (what was accessed)&lt;br&gt;• Data-usage proofs (what influenced outputs / actions)&lt;br&gt;• Overreach detection (accessed-but-not-used)&lt;br&gt;• Minimal-footprint signed attestations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="450" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- Cross-device handoff band (195) NOVEL -->
        <mxCell id="handoff" value="(195) CROSS-DEVICE HANDOFF SUBSYSTEM (Optional)&amp;nbsp;&amp;nbsp;★ NOVEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7F0;strokeColor=#2E7D32;strokeWidth=2;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=6;" vertex="1" parent="1">
