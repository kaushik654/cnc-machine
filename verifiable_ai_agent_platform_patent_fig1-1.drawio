        <mxCell id="h_a" value="&lt;b&gt;Secure State Transfer&lt;/b&gt;&lt;br&gt;Bundle (contract, state snapshot, partial proof roots, last heartbeat) encrypted &amp; transferred via mutual authentication (Knox Matrix)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
