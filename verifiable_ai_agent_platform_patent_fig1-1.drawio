        </mxCell>

        <mxCell id="h_c" value="&lt;b&gt;Continuous Proof Chain&lt;/b&gt;&lt;br&gt;Destination resumes execution; heartbeat &amp; proofs remain cryptographically continuous across devices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;fontSize=11;" vertex="1" parent="1">
